{
  // The browser tests and their configs (ADR 0034). They run in Node, and
  // their page.evaluate callbacks in the browser, so both Node's and the
  // DOM's types apply. Checked by `make fe-typecheck`.
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts", "../playwright.*.config.ts"]
}
