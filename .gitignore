## ==========================================
# Frontend (React / Vite)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / Environment
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# ==========================================
# Backend (Go)
# ==========================================
# Compiled binaries
backend/bin/
backend/main
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib

# SPA asset copy target (if using Option A build step)
backend/internal/spa/dist/

# Test artifacts
*.test
*.out
backend/coverage/

# Live reload artifacts (Air)
backend/tmp/

# ==========================================
# Dev & Environment
# ==========================================
.env
.env.local
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.dll
*.so
*.dylib