{
  "name": "ludustudii",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "google.google-antigravity",
        "openai.chatgpt",
        "anthropic.claude-code",
        "typescriptteam.native-preview",
        "oxc.oxc-vscode",
        "github.vscode-github-actions"
      ],
      "settings": {
        "gopls": {
          "buildFlags": ["-tags=unit,integration,apidocs"]
        },
        "go.lintTool": "golangci-lint-v2",
        "go.lintFlags": ["--fast-only"],
        "go.lintOnSave": "package",
        "go.testTags": "unit,integration,apidocs",
        // Format on save with the pinned oxfmt in frontend/node_modules
        // (ADR 0033), only for languages that occur nowhere but the client
        // app: JSON and HTML elsewhere in the repository aren't oxfmt's to
        // format, so the client app's are left to 'make frontend-fmt'.
        "[javascript][javascriptreact][typescript][typescriptreact][css]": {
          "editor.defaultFormatter": "oxc.oxc-vscode",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "containerEnv": {
    "LANG": "C.UTF-8"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}