{
  "name": "ludustudii",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "typescriptteam.native-preview",
        "oxc.oxc-vscode",
        "github.vscode-github-actions"
      ],
      "settings": {
        "gopls": {
          "buildFlags": ["-tags=unit,integration,apidocs"]
        },
        "go.lintTool": "golangci-lint-v2",
        "go.lintFlags": ["--fast-only"],
        "go.lintOnSave": "package",
        "go.testTags": "unit,integration,apidocs",
        // Format on save with the pinned oxfmt in frontend/node_modules
        // (ADR 0033), only for languages that occur nowhere but the client
        // app: JSON and HTML elsewhere in the repository aren't oxfmt's to
        // format, so the client app's are left to 'make frontend-fmt'.
        "[javascript][javascriptreact][typescript][typescriptreact][css]": {
          "editor.defaultFormatter": "oxc.oxc-vscode",
          "editor.formatOnSave": true
        },
        // Lint with the client app's config. The language server starts at
        // /workspace and would otherwise reject the file as a nested config
        // (`options.typeAware` is root-only) and fall back to the defaults.
        // The path resolves against the workspace folder; its override
        // globs resolve against the file, as with 'make frontend-lint'.
        "oxc.configPath": "frontend/.oxlintrc.json",
        // Oxlint looks for tsgolint from its working directory, /workspace
        // for the language server, so type-aware rules wouldn't start. The
        // extension passes this path to the server as OXLINT_TSGOLINT_PATH;
        // a containerEnv variable wouldn't reach it, because the extension
        // builds the server's environment from a fresh login shell.
        "oxc.path.tsgolint": "/workspace/frontend/node_modules/.bin/tsgolint"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "containerEnv": {
    "LANG": "C.UTF-8"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}